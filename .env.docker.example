# Copy this file to .env.docker before deploying, then edit secrets and ports.

APP_VERSION=local
GATEWAY_HTTP_PORT=8080

# Mainland China mirrors for Docker images and build-time package downloads.
PYTHON_IMAGE=docker.1ms.run/library/python:3.11-slim
NODE_IMAGE=docker.1ms.run/library/node:22-alpine
NGINX_IMAGE=docker.1ms.run/library/nginx:1.27-alpine
POSTGRES_IMAGE=docker.1ms.run/library/postgres:17-alpine
REDIS_IMAGE=docker.1ms.run/library/redis:7.4-alpine
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=0
# App passwords and signing keys are generated under secrets/apps/ by scripts/docker-up.sh.
AUTH_INTROSPECTION_URL=http://auth-backend:8000/api/internal/auth/introspect
AUTH_ORG_INTERNAL_URL=http://auth-backend:8000/api/internal/org
AUTH_INTERNAL_ALLOWED_HOSTS=auth-backend
AUTH_COOKIE_NAME=mj_auth_token
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=0
AUTH_TOKEN_TTL_SECONDS=1800
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_TOKEN_CLOCK_LEEWAY_SECONDS=30
AUTH_DEV_LOGIN_ENABLED=0
WECHAT_MINI_APP_ID=
WECHAT_MINI_DEV_LOGIN_ENABLED=0
WECHAT_MINI_DEV_OPENID=dev-openid
WECHAT_MINI_API_TIMEOUT_SECONDS=5
WECHAT_MINI_REGISTRATION_TTL_SECONDS=600
AUTH_DEV_LOGIN_ALLOW_REMOTE=0
AUTH_DEV_LOGIN_TRUST_PRIVATE_LOCALHOST=0
AUTH_DEV_LOGIN_NAME=
AUTH_INTROSPECTION_TIMEOUT_SECONDS=3
AUTH_HISTORY_RETENTION_DAYS=180
# Local dev login signs in as the first userId in FULL_ACCESS_USER_IDS.
FULL_ACCESS_USER_IDS=

# Leave VITE_API_BASE_URL empty to use the same origin as the gateway.
VITE_API_BASE_URL=
VITE_DING_CLIENT_ID=
VITE_DING_CORP_ID=
VITE_DING_REDIRECT_URI=
VITE_AUTH_DEV_LOGIN=

DINGTALK_CLIENT_ID=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_ROOT_DEPT_ID=1
DINGTALK_JSAPI_ALLOWED_ORIGINS=http://localhost:8080
AUTH_ORG_SYNC_INTERVAL_SECONDS=900
DINGTALK_ORG_SYNC_MAX_USER_DETAIL_ERROR_RATIO=0.05
CRM_DINGTALK_CLIENT_ID=
CRM_DINGTALK_CORP_ID=
CRM_DINGTALK_AGENT_ID=

PRODUCT_ARCHIVE_CATALOG_URL=http://product-archive-backend:8000/api/internal/product-catalog/
PRODUCT_ARCHIVE_CATALOG_SYNC_INTERVAL_SECONDS=300
