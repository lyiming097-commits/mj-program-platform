.git
.gitignore
.codex
.agents
.vscode

# Private configuration and generated platform state. Docker builds use the
# repository root as their context, so these must never be readable by an App
# Dockerfile.
.env
.env.*
**/.env
**/.env.*
*.env.docker
**/*.env.docker
!*.env.docker.example
!**/*.env.docker.example
secrets
**/secrets
.runtime
**/.runtime

# Local databases, uploads, logs, backups and test artefacts.
.local
**/.local
.postgres
**/.postgres
local-data
**/local-data
.local-data
**/.local-data
logs
**/logs
backups
**/backups
test-results
**/test-results
playwright-report
**/playwright-report
blob-report
**/blob-report
coverage
**/coverage
.coverage
**/.coverage
**/.cache
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
**/__pycache__
**/*.pyc
**/*.pyo
**/dist
**/dist-*
*.dump
*.sqlite
*.sqlite3
*.sqlite3-*
node_modules
**/node_modules
export
**/export

apps/*/frontend/dist
apps/*/frontend/dist-*
apps/*/frontend/.env
apps/*/frontend/.env.*

apps/*/backend/.env
apps/*/backend/.env.*
apps/*/backend/db.sqlite3
apps/*/backend/db.sqlite3-*
apps/*/backend/*.log
apps/*/backend/**/__pycache__
apps/*/backend/**/*.pyc
apps/*/backend/images/*
apps/*/backend/files/*
apps/*/backend/media/*
apps/*/backend/uploads/*
apps/*/backend/staticfiles
apps/*/backend/.thumb_cache

*.log
nohup.out
.DS_Store
Thumbs.db
**/Thumbs.db
